# Database
# PostgreSQL connection string
# For Vercel: Use the connection string from your Vercel Postgres database
DATABASE_URL="postgresql://user:password@localhost:5432/shelves?schema=public"

# Authentication
# Generate a strong random secret for JWT signing
# You can generate one with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Email Service (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
# The email address you've verified in Resend (e.g., noreply@yourdomain.com)
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Application URL (optional, auto-detected on Vercel)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment (automatically set by Vercel)
NODE_ENV="production"
